# Copy to .env and fill in. Never commit .env.

# Required for your agents (the placeholder pipeline does not use it)
ANTHROPIC_API_KEY=

# Model your pipeline should use by default
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: real web search (Day 3 bonus)
TAVILY_API_KEY=

# Langfuse tracing (Day 6). These match the local Langfuse started with `--profile tracing`.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-academy-local
LANGFUSE_SECRET_KEY=sk-lf-academy-local

# Mock data realism: latency per request and share of requests that fail with 503
MOCK_LATENCY_MS=60
MOCK_ERROR_RATE=0

# Pipeline limits
PIPELINE_TIMEOUT_S=900

# Reviewer: send-backs to the orchestrator when a pack fails review, and the share of a policy
# excerpt's words that must appear in the section it cites
REVIEW_MAX_SENDBACKS=1
REVIEW_QUOTE_OVERLAP=0.8

# Reviewer LLM stage: REVIEW_LLM=0 turns it off (code checks only); REVIEWER_MODEL defaults to CLAUDE_MODEL
REVIEW_LLM=1
REVIEWER_MODEL=
REVIEWER_TIMEOUT_S=180
# 0 (default): the LLM stage only warns. 1: its findings can block and send the pack back.
REVIEW_LLM_BLOCKS=0
MAX_CONCURRENT_RUNS=4
